# Quantum of Solace — backend configuration.
# Copy to `.env` (never committed) and fill in only what you use.
# All values are optional: without them, backends report `simulated`
# or `not_configured` and the local simulator handles execution.

# --- Control hardware (lab) -------------------------------------------------
# RFSoC running QICK (AMD Xilinx ZCU111 / ZCU216), reachable via Pyro4/nameserver
QSOLACE_QICK_HOST=
QSOLACE_QICK_BOARD=zcu216            # zcu111 | zcu216

# Quantum Machines OPX / QOP cluster
QSOLACE_QM_HOST=
QSOLACE_QM_PORT=9510

# QBLOX Cluster
QSOLACE_QBLOX_HOST=

# --- Quantum platforms -------------------------------------------------------
# ORCA Computing PT-Series (PT-2)
QSOLACE_ORCA_URL=
QSOLACE_ORCA_TOKEN=

# IQM (Resonance or on-prem)
QSOLACE_IQM_URL=
QSOLACE_IQM_TOKEN=

# Atom Computing
QSOLACE_ATOM_URL=
QSOLACE_ATOM_TOKEN=

# QuEra (direct; QuEra Aquila is also reachable through AWS Braket below)
QSOLACE_QUERA_TOKEN=

# --- Cloud services ----------------------------------------------------------
# AWS Braket: uses the standard AWS credential chain
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
QSOLACE_BRAKET_DEVICE_ARN=

# Strangeworks
STRANGEWORKS_API_KEY=
